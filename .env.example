# agentrouter-mcp configuration
# Command to fetch the AgentRouter API key on-demand (key never stored on disk or in env vars)
AGENTROUTER_KEY_CMD="secret-tool lookup service agentrouter"

# Optional: default model when not specified in tool calls
# AGENTROUTER_DEFAULT_MODEL="gpt-6.1-sol"

# Optional: base URL for AgentRouter OpenAI-compatible API
# AGENTROUTER_BASE_URL="https://agentrouter.org/v1"

# Optional: request timeout in seconds
# AGENTROUTER_TIMEOUT="300"
